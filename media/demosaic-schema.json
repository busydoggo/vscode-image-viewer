{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "%demosaic.schema.title%",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "regularization",
    "variationPenalty",
    "directions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "regularization": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100,
      "description": "%demosaic.schema.regularization%"
    },
    "variationPenalty": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "%demosaic.schema.variationPenalty%"
    },
    "directions": {
      "type": "object",
      "description": "%demosaic.schema.directions%",
      "additionalProperties": false,
      "required": [
        "0",
        "45",
        "90",
        "135",
        "180",
        "225",
        "270",
        "315"
      ],
      "properties": {
        "0": {
          "$ref": "#/definitions/group"
        },
        "45": {
          "$ref": "#/definitions/group"
        },
        "90": {
          "$ref": "#/definitions/group"
        },
        "135": {
          "$ref": "#/definitions/group"
        },
        "180": {
          "$ref": "#/definitions/group"
        },
        "225": {
          "$ref": "#/definitions/group"
        },
        "270": {
          "$ref": "#/definitions/group"
        },
        "315": {
          "$ref": "#/definitions/group"
        }
      }
    },
    "antiAlias": {
      "type": "object",
      "description": "%demosaic.schema.antiAlias%",
      "additionalProperties": false,
      "required": [
        "enabled",
        "greenThreshold",
        "chromaThreshold",
        "directionFloor",
        "directionSpan",
        "syntheticWeight"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "%demosaic.schema.antiAliasEnabled%"
        },
        "greenThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "%demosaic.schema.greenThreshold%"
        },
        "chromaThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "%demosaic.schema.chromaThreshold%"
        },
        "directionFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "%demosaic.schema.directionFloor%"
        },
        "directionSpan": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1,
          "description": "%demosaic.schema.directionSpan%"
        },
        "syntheticWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "%demosaic.schema.syntheticWeight%"
        }
      }
    }
  },
  "definitions": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strength",
              "uniform",
              "edgePower",
              "tangentBias"
            ],
            "properties": {
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "%demosaic.schema.strength%"
              },
              "uniform": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "%demosaic.schema.uniform%"
              },
              "edgePower": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "%demosaic.schema.edgePower%"
              },
              "tangentBias": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "%demosaic.schema.tangentBias%"
              }
            }
          }
        }
      }
    }
  }
}
