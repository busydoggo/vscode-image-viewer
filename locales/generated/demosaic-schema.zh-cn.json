{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bayer 解马赛克系数",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "regularization",
    "variationPenalty",
    "directions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "regularization": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100,
      "description": "采样量化步长平方的正则项倍数。"
    },
    "variationPenalty": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "抑制平滑颜色变化的过度锐化。"
    },
    "directions": {
      "type": "object",
      "description": "图像坐标顺时针，0° 向右，90° 向下，对向射线可独立配置。",
      "additionalProperties": false,
      "required": [
        "0",
        "45",
        "90",
        "135",
        "180",
        "225",
        "270",
        "315"
      ],
      "properties": {
        "0": {
          "$ref": "#/definitions/group"
        },
        "45": {
          "$ref": "#/definitions/group"
        },
        "90": {
          "$ref": "#/definitions/group"
        },
        "135": {
          "$ref": "#/definitions/group"
        },
        "180": {
          "$ref": "#/definitions/group"
        },
        "225": {
          "$ref": "#/definitions/group"
        },
        "270": {
          "$ref": "#/definitions/group"
        },
        "315": {
          "$ref": "#/definitions/group"
        }
      }
    },
    "antiAlias": {
      "type": "object",
      "description": "保守的方向抗锯齿修正。旧配置文件使用内置默认值。",
      "additionalProperties": false,
      "required": [
        "enabled",
        "greenThreshold",
        "chromaThreshold",
        "directionFloor",
        "directionSpan",
        "syntheticWeight"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "在方向候选分歧较大时稳定绿色重建；关闭可对比原有解码效果。"
        },
        "greenThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "触发修正的水平/垂直绿色候选最小差值，使用归一化传感器数值（0–1）。默认 12/255。数值越大，保留原重建的区域越多。"
        },
        "chromaThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "红蓝通道反向变化超过此归一化幅度时，保护真实颜色边界。默认 80/255。"
        },
        "directionFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "允许修正绿色重建的最小邻域方向置信度。默认 0.05。"
        },
        "directionSpan": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1,
          "description": "修正强度从零到完全生效的置信度区间。默认 0.25。"
        },
        "syntheticWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "RGB-IR 补出采样在邻域判断中的相对权重。原始实测采样的权重始终为 1。默认 0.25。"
        }
      }
    }
  },
  "definitions": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strength",
              "uniform",
              "edgePower",
              "tangentBias"
            ],
            "properties": {
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "归一化梯度阈值，从 0 开始严格递增。"
              },
              "uniform": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "均匀权重比例，1 均匀，0 完全按边缘加权。"
              },
              "edgePower": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "越大越抑制跨颜色边缘的采样。"
              },
              "tangentBias": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "沿边缘方向的采样偏好。"
              }
            }
          }
        }
      }
    }
  }
}
