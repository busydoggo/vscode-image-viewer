{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bayer demosaic coefficients",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "regularization",
    "variationPenalty",
    "directions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "regularization": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100,
      "description": "Squared sample-step noise floor multiplier."
    },
    "variationPenalty": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Suppress sharpening of smooth color variation."
    },
    "directions": {
      "type": "object",
      "description": "Clockwise image coordinates: 0° right, 90° down. Opposite rays are independent.",
      "additionalProperties": false,
      "required": [
        "0",
        "45",
        "90",
        "135",
        "180",
        "225",
        "270",
        "315"
      ],
      "properties": {
        "0": {
          "$ref": "#/definitions/group"
        },
        "45": {
          "$ref": "#/definitions/group"
        },
        "90": {
          "$ref": "#/definitions/group"
        },
        "135": {
          "$ref": "#/definitions/group"
        },
        "180": {
          "$ref": "#/definitions/group"
        },
        "225": {
          "$ref": "#/definitions/group"
        },
        "270": {
          "$ref": "#/definitions/group"
        },
        "315": {
          "$ref": "#/definitions/group"
        }
      }
    }
  },
  "definitions": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strength",
              "uniform",
              "edgePower",
              "tangentBias"
            ],
            "properties": {
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "Normalized gradient threshold; start at 0 and increase strictly."
              },
              "uniform": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Uniform-weight fraction: 1 = balanced, 0 = fully edge weighted."
              },
              "edgePower": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "Larger values reject samples across color edges more strongly."
              },
              "tangentBias": {
                "type": "number",
                "minimum": 0,
                "maximum": 4,
                "description": "Preference for candidates along the edge tangent."
              }
            }
          }
        }
      }
    }
  }
}
